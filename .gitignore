# Environment / secrets
.env
secrets/*
!secrets/*.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.python-version

# Ruff / linters
.ruff_cache/

# Pytest
.pytest_cache/
.coverage

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store

# Data / artifacts — keep directory structure, ignore actual data files
/data/*
!/data/.gitkeep
# Experiments — keep run results (config, metrics, submission), ignore heavy embeddings
/experiments/*
!/experiments/.gitkeep
!/experiments/*/
/experiments/*/*.npz
/experiments/*/*.npy

# Model artifacts: keep directory, ignore large weights.
models/*.onnx
models/*.pt
models/*.pth
models/*.ckpt
models/*.bin

# Local (machine-specific) experiment configs.
# Keep reproducible configs in configs/experiments/.
configs/local/
