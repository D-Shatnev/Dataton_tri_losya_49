# Environment / secrets
.env
secrets/*
!secrets/*.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.python-version

# Ruff / linters
.ruff_cache/

# Pytest
.pytest_cache/
.coverage

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store

# Submission artifacts in project root
/submission*.csv

# Data / artifacts — keep directory structure, ignore actual data files
/data/*
!/data/.gitkeep
# Experiments — keep run results (config, metrics), ignore heavy embeddings and submissions.
# submission.csv files are excluded: they are too large for the repo and carry less
# value than other experiment artifacts (config, timing, metrics).
/experiments/*
!/experiments/.gitkeep
!/experiments/*/
/experiments/*/*.npz
/experiments/*/*.npy
/experiments/*/submission.csv

# Model artifacts: weights are tracked via Git LFS (see .gitattributes).
# Only the directory placeholder is kept here; actual weight files go through LFS.
!models/.gitkeep

# Local (machine-specific) experiment configs.
# Keep reproducible configs in configs/experiments/.
configs/local/
