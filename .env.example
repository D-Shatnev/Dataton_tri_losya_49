# ============================================================
# Speaker Recognition pipeline — environment variables
# ============================================================
# Скопируйте этот файл в .env и отредактируйте под свои нужды:
#   cp .env.example .env
#
# Docker Compose автоматически подхватывает .env из корня проекта.
# ============================================================

# ------------------------------------------------------------
# speakerid-infer (docker compose run --rm infer)
# ------------------------------------------------------------

# Входной CSV с колонкой filepath (пути относительно ROOT_PATH)
CSV_PATH=data/test_public.csv

# Выходной submission CSV
OUT_PATH=data/submission.csv

# Корневая директория для разрешения относительных путей из CSV
ROOT_PATH=data

# ------------------------------------------------------------
# speakerid-experiment (docker compose run --rm experiment)
# ------------------------------------------------------------

# Путь к TOML-конфигу эксперимента
EXPERIMENT_CONFIG=configs/experiments/onnx_baseline_test_public.toml

# Размер батча для энкодера
BATCH_SIZE=1
