# Git LFS tracking for model weights and large binary artifacts

# PyTorch weights
models/**/*.pt filter=lfs diff=lfs merge=lfs -text
models/**/*.pth filter=lfs diff=lfs merge=lfs -text
models/**/*.bin filter=lfs diff=lfs merge=lfs -text

# ONNX models
models/**/*.onnx filter=lfs diff=lfs merge=lfs -text

# Safetensors
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text

# NumPy / compressed arrays (e.g. embeddings stored alongside models)
models/**/*.npz filter=lfs diff=lfs merge=lfs -text
models/**/*.npy filter=lfs diff=lfs merge=lfs -text

# Pickle-based checkpoints
models/**/*.pkl filter=lfs diff=lfs merge=lfs -text
models/**/*.pickle filter=lfs diff=lfs merge=lfs -text
